GALILEO_SECRET_KEY=run: openssl rand -hex 32
GALILEO_PUBLIC_API=http://localhost:8080
# Outbound e-mail (blank host = disabled). For a local sink: host.docker.internal / 1025 / security none
GALILEO_SMTP_HOST=
GALILEO_SMTP_PORT=587
GALILEO_SMTP_USER=
GALILEO_SMTP_PASSWORD=
GALILEO_SMTP_FROM=Galileo <galileo@localhost>
GALILEO_SMTP_SECURITY=starttls

# --- Production (docker-compose.prod.yml) ---
# Caddyfile.cloudflare (default: TLS terminated by Cloudflare) or Caddyfile (Caddy's own TLS)
# GALILEO_CADDYFILE=Caddyfile.cloudflare
# GALILEO_WEB_DOMAIN=galileo.example.com
# GALILEO_API_DOMAIN=galileo-api.example.com
# GALILEO_PUBLIC_URL=https://galileo.example.com
# GALILEO_PUBLIC_API=https://galileo-api.example.com
# GALILEO_CORS_ORIGINS=["https://galileo.example.com"]
# Loopback debug publishes; set only if a default collides with another stack on the host.
# GALILEO_HOST_API_PORT=8080
# GALILEO_HOST_WEB_PORT=3000
# GALILEO_HOST_POSTGRES_PORT=5433
# GALILEO_HOST_OTLP_GRPC_PORT=4317
# GALILEO_HOST_OTLP_HTTP_PORT=4318
# GALILEO_HOST_CLICKHOUSE_HTTP_PORT=8123
# GALILEO_HOST_CLICKHOUSE_NATIVE_PORT=9000
