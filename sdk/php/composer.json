{
  "name": "galileo/php",
  "description": "Galileo observability for PHP and Laravel: OpenTelemetry spans with call-site attribution, user identity, a Monolog handler and exception reporting.",
  "type": "library",
  "license": "MIT",
  "require": {
    "php": ">=8.1",
    "open-telemetry/sdk": "^1.1",
    "open-telemetry/exporter-otlp": "^1.1",
    "open-telemetry/api": "^1.1",
    "psr/log": "^3.0",
    "guzzlehttp/guzzle": "^7.8",
    "guzzlehttp/psr7": "^2.6",
    "php-http/guzzle7-adapter": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "monolog/monolog": "^3.0"
  },
  "suggest": {
    "illuminate/support": "Laravel service provider (request span, DB::listen query spans, Auth identity, exception handler)"
  },
  "autoload": {
    "psr-4": {
      "Galileo\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Galileo\\Tests\\": "tests/"
    }
  },
  "extra": {
    "laravel": {
      "providers": [
        "Galileo\\Laravel\\GalileoServiceProvider"
      ]
    }
  },
  "scripts": {
    "test": "phpunit"
  }
}