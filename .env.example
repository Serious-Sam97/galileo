# Copy to .env when you want to override galileo.toml without editing it.
GALILEO_SERVER__SECRET_KEY=change-me-run-openssl-rand-hex-32
GALILEO_CLICKHOUSE__URL=http://127.0.0.1:8123
GALILEO_POSTGRES__URL=postgres://galileo:galileo@127.0.0.1:5433/galileo
RUST_LOG=info,galileo=debug

# ---------------------------------------------------------------- hosted deployment (deploy/.env)
# Used by deploy/docker-compose.prod.yml + Caddy (two hostnames; TLS by Cloudflare by default,
# or by Caddy itself with GALILEO_CADDYFILE=Caddyfile).
# GALILEO_WEB_DOMAIN=galileo.serious-sam.dev
# GALILEO_API_DOMAIN=galileo-api.serious-sam.dev
# GALILEO_PUBLIC_URL=https://galileo.serious-sam.dev        # UI address used in notification links
# GALILEO_PUBLIC_API=https://galileo-api.serious-sam.dev    # baked into the web image at build time
# GALILEO_CORS_ORIGINS=["https://galileo.serious-sam.dev"]  # browser origins allowed to call the API
